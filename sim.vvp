S_0x105034f10 .scope module, "muxtest" "muxtest" 2 1;
 .timescale 0 0;
v0x105039c50_0 .var "A", 15 0;
v0x105039cf0_0 .net "F", 0 0, L_0x105039e30;  1 drivers
v0x105039d90_0 .var "S", 3 0;
S_0x105034030 .scope module, "mux1" "mux16to1" 2 6, 3 1 0, S_0x105034f10;
 .timescale 0 0;
    .port_info 0 /INPUT 16 "in";
    .port_info 1 /INPUT 4 "sel";
    .port_info 2 /OUTPUT 1 "out";
v0x1050341b0_0 .net "in", 15 0, v0x105039c50_0;  1 drivers
v0x105039b10_0 .net "out", 0 0, L_0x105039e30;  alias, 1 drivers
v0x105039bb0_0 .net "sel", 3 0, v0x105039d90_0;  1 drivers
L_0x105039e30 .part/v v0x105039c50_0, v0x105039d90_0, 1;
    .scope S_0x105034f10;
T_0 ;
    %vpi_call 2 10 "$dumpfile", "muxtest.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x105034f10 {0 0 0};
    %delay 5, 0;
    %pushi/vec4 16138, 0, 16;
    %store/vec4 v0x105039c50_0, 0, 16;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x105039d90_0, 0, 4;
    %delay 5, 0;
    %pushi/vec4 3, 0, 4;
    %store/vec4 v0x105039d90_0, 0, 4;
    %delay 5, 0;
    %pushi/vec4 5, 0, 4;
    %store/vec4 v0x105039d90_0, 0, 4;
    %delay 10, 0;
    %delay 5, 0;
    %pushi/vec4 15, 0, 4;
    %store/vec4 v0x105039d90_0, 0, 4;
    %delay 10, 0;
    %vpi_call 2 28 "$finish" {0 0 0};
    %end;
    .thread T_0;
