:vpi_module "/opt/homebrew/Cellar/icarus-verilog/12.0/lib/ivl/va_math.vpi";
S_0x103860df0 .scope module, "muxtest" "muxtest" 2 1;
 .timescale 0 0;
v0x1038652b0_0 .var "A", 15 0;
v0x103865350_0 .net "F", 0 0, L_0x103865490;  1 drivers
v0x1038653f0_0 .var "S", 3 0;
S_0x10385fed0 .scope module, "mux1" "mux16to1" 2 6, 3 1 0, S_0x103860df0;
 .timescale 0 0;
    .port_info 0 /INPUT 16 "in";
    .port_info 1 /INPUT 4 "sel";
    .port_info 2 /OUTPUT 1 "out";
v0x103860050_0 .net "in", 15 0, v0x1038652b0_0;  1 drivers
v0x1038600f0_0 .net "out", 0 0, L_0x103865490;  alias, 1 drivers
v0x103865210_0 .net "sel", 3 0, v0x1038653f0_0;  1 drivers
L_0x103865490 .part/v v0x1038652b0_0, v0x1038653f0_0, 1;
    .scope S_0x103860df0;
T_0 ;
    %vpi_call 2 10 "$dumpfile", "muxtest.vcd" {0 0 0};
    %vpi_call 2 11 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x103860df0 {0 0 0};
    %vpi_call 2 12 "$monitor", $time, " A=%h, S=%h, F=%b", v0x1038652b0_0, v0x1038653f0_0, v0x103865350_0 {0 0 0};
    %delay 5, 0;
    %pushi/vec4 16138, 0, 16;
    %store/vec4 v0x1038652b0_0, 0, 16;
    %pushi/vec4 0, 0, 4;
    %store/vec4 v0x1038653f0_0, 0, 4;
    %delay 5, 0;
    %pushi/vec4 1, 0, 4;
    %store/vec4 v0x1038653f0_0, 0, 4;
    %delay 5, 0;
    %pushi/vec4 6, 0, 4;
    %store/vec4 v0x1038653f0_0, 0, 4;
    %delay 5, 0;
    %pushi/vec4 12, 0, 4;
    %store/vec4 v0x1038653f0_0, 0, 4;
    %vpi_call 2 21 "$finish" {0 0 0};
    %end;
    .thread T_0;
